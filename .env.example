# Copy to .env for local development. NEVER commit a real key.
# The server reads the API key from the environment only — it can never be
# supplied as an MCP tool argument.

# Required.
SMARTLEAD_API_KEY=

# Optional. Override only if Smartlead tells you to (self-hosted / regional host).
# SMARTLEAD_CORE_BASE_URL=https://server.smartlead.ai/api/v1
# SMARTLEAD_PROSPECT_BASE_URL=https://prospect-api.smartlead.ai/api/v1/search-email-leads

# Optional. readonly | standard | unrestricted   (default: readonly)
# SMARTLEAD_MCP_MODE=readonly

# Optional gates. All default to false.
# SMARTLEAD_MCP_ALLOW_CREDIT_SPEND=false
# SMARTLEAD_MCP_ALLOW_SEND=false
# SMARTLEAD_MCP_ALLOW_DESTRUCTIVE=false

# Optional. Per-request timeout in milliseconds (1000-600000). Default: 30000.
# SMARTLEAD_MCP_TIMEOUT_MS=30000

# Optional. Retries for safe idempotent GET requests only (0-5). Default: 2.
# SMARTLEAD_MCP_MAX_RETRIES=2

# Live tests only. Read-only; never spends credits.
# SMARTLEAD_LIVE_TESTS=false
